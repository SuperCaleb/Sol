    def preprocess_frame_for_physics(self, frame):
        """Preprocess frame for physics model."""
        frame = cv2.resize(frame, (224, 224))
        frame = frame / 255.0
        return np.expand_dims(frame, axis=0)

    def preprocess_frame_for_chemistry(self, frame):
        """Preprocess frame for chemistry model (simulated spectroscopic data)."""
        frame = cv2.resize(frame, (224, 224))
        frame = frame / 255.0  # Simulate spectral image normalization
        return np.expand_dims(frame, axis=0)

    def preprocess_weather_data(self, weather_data):
        """Preprocess weather data for environmental model."""
        # Simulate 10 timesteps by repeating current data (in practice, use historical data)
        features = [weather_data['main']['temp'] - 273.15,  # Convert Kelvin to Celsius
                    weather_data['main']['humidity'],
                    weather_data['wind']['speed']]
        # Repeat for 10 timesteps
        data = np.array([features] * 10).reshape(1, 10, 3)
        return data

    def preprocess_sky_frame(self, sky_frame):
        """Preprocess sky frame for space model."""
        sky_frame = cv2.resize(sky_frame, (224, 224))
        sky_frame = sky_frame / 255.0
