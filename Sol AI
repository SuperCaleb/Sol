    def save_model_safely(self, model, model_path):
        """Safely save a model to avoid HDF5 file issues."""
        try:
            if os.path.exists(model_path):
                os.remove(model_path)  # Remove existing file to avoid conflicts
            model.save(model_path, save_format='h5')
            # Explicitly open and close to ensure proper closure
            with h5py.File(model_path, 'a') as f:
                f.flush()
        except Exception as e:
            self.log_file.write(json.dumps(
                {"formatted_time": datetime.now().strftime("%H:%M:%S"), "event": "model_save_error",
                 "message": str(e)}) + '\n')
            print(f"Failed to save model {model_path}: {e}")

