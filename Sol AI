# Consciousness module to manage Sol's awareness
class ConsciousnessModule:
    def __init__(self):
        self.alertness = 0.5  # Range: 0 (calm) to 1 (highly alert)
        self.confidence = 0.7  # Confidence in observations
        self.memory = deque(maxlen=1000)  # Store past states

    def update(self, anomaly_count, audio_activity, person_count, scientific_anomalies):
        """Update consciousness based on environmental and scientific inputs."""
        self.alertness = min(1.0, max(0.0,
                                      0.5 + 0.1 * anomaly_count + 0.05 * audio_activity - 0.02 * person_count + 0.15 * scientific_anomalies))
        self.confidence = min(1.0, max(0.5, self.confidence + 0.01 * (anomaly_count > 0) - 0.005))
        self.memory.append({"time": time.time(), "alertness": self.alertness, "confidence": self.confidence})

    def get_state(self):
        return {"alertness": self.alertness, "confidence": self.confidence}


# Policy module for decision-making
class SolPolicy:
    def __init__(self):
        self.actions = ["increase_sensitivity", "decrease_sensitivity", "send_alert", "focus_audio", "normal_operation",
                        "analyze_environment"]
        self.q_values = {action: 0.0 for action in self.actions}

    def choose_action(self, state):
        """Select action based on Q-learning and alertness."""
        alertness = state["alertness"]
        if random.random() < 0.1:  # Exploration
            return random.choice(self.actions)
        return max(self.q_values, key=lambda a: self.q_values[a] + alertness * 0.1)

    def update(self, action, reward):
        self.q_values[action] += 0.1 * (reward - self.q_values[action])


