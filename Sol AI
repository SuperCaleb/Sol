    def setup_surveillance(self, video_source):
        """Initialize video, audio, and AI components."""
        try:
            self.cap = cv2.VideoCapture(video_source)
            if not self.cap.isOpened():
                raise Exception(f"Failed to open video source: {video_source}")

            self.frame_width = int(self.cap.get(cv2.CAP_PROP_FRAME_WIDTH))
            self.frame_height = int(self.cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
            self.out = cv2.VideoWriter('output.avi', cv2.VideoWriter_fourcc(*'XVID'), 20.0,
                                       (self.frame_width, self.frame_height))

            self.model = YOLO("yolov8l.pt")
            self.tracker = DeepSort(max_age=30)

            self.speech_queue = queue.Queue()
            self.tts = pyttsx3.init()
            voices = self.tts.getProperty('voices')
            for voice in voices:
                if "David" in voice.name:
                    self.tts.setProperty('voice', voice.id)
                    break
            self.tts.setProperty("rate", 130)
            self.tts.setProperty("pitch", -15)
            self.speech_thread = threading.Thread(target=self._speech_loop, daemon=True)
            self.speech_thread.start()

            self.audio_stream = sd.InputStream(callback=self.audio_callback, samplerate=16000, channels=1)
            self.audio_buffer = []
            self.yamnet_model = hub.load('https://tfhub.dev/google/yamnet/1')
            self.yamnet_classes = [line.split(',')[1].strip() for line in open(tf.keras.utils.get_file(
                'yamnet_class_map.csv',
                'https://raw.githubusercontent.com/tensorflow/models/master/research/audioset/yamnet/yamnet_class_map.csv'
            )).readlines()[1:]]
            self.forensic_audio_classes = ["Gunshot, gunfire", "Scream", "Glass breaking", "Explosion"]
            self.latest_audio_scores = np.zeros(len(self.forensic_audio_classes))
            self.audio_stream.start()

            self.log_file = open('sol_detections.log', 'w')
            self.thought_generator = GPT2LMHeadModel.from_pretrained("gpt2")
            self.tokenizer = GPT2Tokenizer.from_pretrained("gpt2")

        except Exception as e:
            self._cleanup()
            raise e

    def _speech_loop(self):
        """Handle speech output in a separate thread."""
        while True:
            message = self.speech_queue.get()
            if message is None:
                break
            self.tts.say(message)
            self.tts.runAndWait()
            self.speech_queue.task_done()

    def audio_callback(self, indata, frames, time_info, status):
        """Process audio input for anomaly detection."""
        try:
            self.audio_buffer.extend(indata[:, 0])
            if len(self.audio_buffer) >= 16000:
                audio_data = np.array(self.audio_buffer[:16000], dtype=np.float32)
                self.audio_buffer = self.audio_buffer[16000:]
                if np.max(np.abs(audio_data)) > 1.0:
                    audio_data /= np.max(np.abs(audio_data))
                if self.yamnet_model:
                    scores, _, _ = self.yamnet_model(audio_data)
                    forensic_indices = [self.yamnet_classes.index(cls) for cls in self.forensic_audio_classes if
                                        cls in self.yamnet_classes]
                    if forensic_indices:
                        self.latest_audio_scores = tf.reduce_mean(scores[:, forensic_indices], axis=0).numpy()
                        top_classes = np.argsort(tf.reduce_mean(scores, axis=0).numpy())[-3:]
                        for cls in top_classes:
                            cls_name = self.yamnet_classes[cls]
                            if cls_name in self.forensic_audio_classes:
                                current_time = datetime.now().strftime("%H:%M:%S")
                                self.log_event("audio_event", cls_name, current_time)
                                self.reflect_on_event("audio_event", cls_name)
        except Exception as e:
            self.log_file.write(json.dumps(
                {"formatted_time": datetime.now().strftime("%H:%M:%S"), "event": "error", "message": str(e)}) + '\n')

    def speak(self, message, urgency="normal"):
        """Speak a message with cooldown or urgency override."""
        if time.time() - self.last_speak_time > self.SPEAK_COOLDOWN or urgency == "high":
            if urgency == "high":
                self.speech_queue.put_nowait(message)
            else:
                self.speech_queue.put(message)
            self.last_speak_time = time.time()

    def _cleanup(self):
        """Release resources on shutdown."""
        if hasattr(self, 'cap') and self.cap.isOpened():
            self.cap.release()
        if hasattr(self, 'out'):
            self.out.release()
        if hasattr(self, 'log_file'):
            self.log_file.close()
        if hasattr(self, 'audio_stream'):
            self.audio_stream.stop()
            self.audio_stream.close()
        self.speech_queue.put(None)

    def log_event(self, event_type, details, timestamp):
        """Log events to memory and file."""
        log_entry = {"formatted_time": timestamp, "event": event_type, "details": details}
        self.recent_events.append(log_entry)
        self.memory.append(log_entry)
        self.log_file.write(json.dumps(log_entry) + '\n')

    def reflect_on_event(self, event_type, details, **kwargs):
        """Generate and speak a thoughtful response to an event."""
        template = random.choice(self.THUGHT_TEMPLATES.get(event_type, ["Event: {details}"]))
        thought = template.format(details=details, **kwargs)
        inputs = self.tokenizer(thought, return_tensors="pt")
        outputs = self.thought_generator.generate(inputs["input_ids"], max_length=50, num_return_sequences=1)
        reflection = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
        self.speak(reflection)
        self.log_file.write(json.dumps(
            {"formatted_time": datetime.now().strftime("%H:%M:%S"), "event": "thought", "message": reflection}) + '\n')

