    def run_surveillance(self):
        """Main surveillance loop with scientific analysis."""
        print("🚀 Sol - The Sentient Watcher Awakens")
        threading.Thread(target=self.read_input, daemon=True).start()
        previous_positions = {}

        while self.cap.isOpened():
            try:
                start_frame_time = time.time()
                ret, frame = self.cap.read()
                if not ret:
                    break

                current_time = time.time()

                # Object detection
                results = self.model(frame, conf=0.5)
                detections = []
                for r in results:
                    boxes = r.boxes.xyxy.cpu().numpy()
                    scores = r.boxes.conf.cpu().numpy()
                    classes = r.boxes.cls.cpu().numpy()
                    for box, score, cls in zip(boxes, scores, classes):
                        x1, y1, x2, y2 = map(int, box)
                        detections.append(([x1, y1, x2 - x1, y2 - y1], score, self.model.names[int(cls)]))

                # Object tracking
                tracks = self.tracker.update_tracks(detections, frame=frame)
                confirmed_tracks = [track for track in tracks if track.is_confirmed()]
                current_track_ids = set(track.track_id for track in confirmed_tracks)

                # Anomaly detection and visualization
                person_count = 0
                for track in confirmed_tracks:
                    if track.det_class != "person":
                        continue
                    person_count += 1
                    id = track.track_id
                    ltrb = track.to_ltrb()
                    x1, y1, x2, y2 = map(int, ltrb)
                    position = ((x1 + x2) / 2, (y1 + y2) / 2)

                    cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
                    cv2.putText(frame, f"{track.det_class} ID:{id}", (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.9,
                                (0, 255, 0), 2)

                    self.log_event("detection", f"{track.det_class} ID:{id}", datetime.now().strftime("%H:%M:%S"))
                    if id not in previous_positions:
                        self.reflect_on_event("new_detection", track.det_class)

                    # Track management and anomaly detection
                    if id not in self.active_tracks:
                        self.active_tracks[id] = {"start_time": current_time, "positions": [position],
                                                  "times": [current_time], "last_position": position}
                    else:
                        track_data = self.active_tracks[id]
                        last_position = track_data["last_position"]
                        last_time = track_data["times"][-1]
                        dt = current_time - last_time
                        if dt > 0:
                            distance = np.linalg.norm(np.array(position) - np.array(last_position))
                            speed = distance / dt
                            track_data["speed"] = speed
                            if len(track_data["positions"]) >= 2:
                                pos1, pos2 = track_data["positions"][-2], track_data["positions"][-1]
                                t1, t2 = track_data["times"][-2], track_data["times"][-1]
                                dt_prev = t2 - t1
                                if dt_prev > 0:
                                    distance_prev = np.linalg.norm(np.array(pos2) - np.array(pos1))
                                    speed_prev = distance_prev / dt_prev
                                    acceleration = (speed - speed_prev) / dt
                                    track_data["acceleration"] = acceleration
                                    if abs(acceleration) > self.ACCELERATION_THRESHOLD:
                                        self.log_event("anomaly", "high_acceleration",
                                                       datetime.now().strftime("%H:%M:%S"))
                                        self.reflect_on_event("high_acceleration", id, acceleration=acceleration)
                            if speed > self.SPEED_THRESHOLD:
                                self.log_event("anomaly", "high_speed", datetime.now().strftime("%H:%M:%S"))
                                self.reflect_on_event("high_speed", id, speed=speed)
                        track_data["positions"].append(position)
                        track_data["times"].append(current_time)
                        track_data["last_position"] = position

                # Update consciousness
                anomaly_count = len([e for e in self.recent_events if e["event"] == "anomaly"])
                scientific_anomalies = len([e for e in self.recent_events if e["event"] == "scientific_anomaly"])
                audio_activity = np.max(self.latest_audio_scores)
                self.consciousness.update(anomaly_count, audio_activity, person_count, scientific_anomalies)

                # Autonomous decision-making
                if current_time - self.last_action_time > 60:  # Every minute
                    state = self.consciousness.get_state()
                    action = self.policy.choose_action(state)
                    self.execute_action(action)
                    reward = 1.0 if state["alertness"] > 0.7 and action in ["send_alert",
                                                                            "increase_sensitivity"] else 0.5
                    self.policy.update(action, reward)
                    self.last_action_time = current_time

                # Self-reflection
                if current_time - self.last_status_time > 300:
                    state = self.consciousness.get_state()
                    thought = f"Alertness at {state['alertness']:.2f}. I sense {'urgency' if state['alertness'] > 0.7 else 'calm'}."
                    self.reflect_on_event("self_reflection", {"alertness": state['alertness']})
                    self.last_status_time = current_time

                # Cleanup inactive tracks
                active_ids = set(self.active_tracks.keys())
                for id in active_ids - current_track_ids:
                    del self.active_tracks[id]

                previous_positions = {track.track_id: track.to_ltrb() for track in confirmed_tracks}
                self.out.write(frame)
                cv2.imshow("Sol Surveillance", frame)

                try:
                    command = self.command_queue.get_nowait()
                    response = self.process_command(command)
                    self.speak(response)
                except queue.Empty:
                    pass

                if cv2.waitKey(1) & 0xFF == ord('q'):
                    break

            except Exception as e:
                self.log_file.write(json.dumps({"formatted_time": datetime.now().strftime("%H:%M:%S"), "event": "error",
                                                "message": str(e)}) + '\n')

        self._cleanup()
        cv2.destroyAllWindows()

    def process_command(self, command):
        """Process user commands."""
        if command == "status":
            state = self.consciousness.get_state()
            return f"Alertness: {state['alertness']:.2f}, Confidence: {state['confidence']:.2f}, Monitoring {len(self.active_tracks)} entities."
        elif command == "explain_last_detection":
            if self.recent_events:
                last_event = self.recent_events[-1]
                return f"Last event: {last_event['event']} - {last_event['details']} at {last_event['formatted_time']}"
            return "No recent events."
        return "I hear you, but I decide my path."

    def read_input(self):
        """Read user input in a separate thread."""
        while True:
            command = input().strip()
            if command:
                self.command_queue.put(command)


