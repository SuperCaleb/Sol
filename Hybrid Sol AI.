        self.audio_stream.stop()
        self.depth_queue.put(None)
        self.depth_thread.join()
        cv2.destroyAllWindows()

    def audio_callback(self, indata, frames, time, status):
        self.audio_buffer.extend(indata[:, 0])
        if len(self.audio_buffer) >= 16000:
            audio_data = np.array(self.audio_buffer[:16000], dtype=np.float32)
            self.audio_buffer = self.audio_buffer[16000:]
            if np.max(np.abs(audio_data)) > 1.0:
                audio_data /= np.max(np.abs(audio_data))
            scores, _, _ = self.yamnet_model(audio_data)
            forensic_indices = [self.yamnet_classes.index(cls) for cls in self.forensic_audio_classes if cls in self.yamnet_classes]
            self.latest_audio_scores = tf.reduce_mean(scores[:, forensic_indices], axis=0).numpy() if forensic_indices else np.zeros(len(self.forensic_audio_classes))
            current_time = datetime.now().strftime("%H:%M:%S")
            for cls, score in zip(self.forensic_audio_classes, self.latest_audio_scores):
                if score > 0.5:
                    self.speak(f"{cls} pierces the silence. Your chaos deafens even me.", urgency="high")
                    log_entry = json.dumps({"timestamp": current_time, "event": "audio_event", "type": cls, "score": float(score)})
                    self.log_file.write(self.cipher.encrypt(log_entry.encode()) + b'\n')

    def _speech_loop(self):
        while True:
            message = self.speech_queue.get()
            if message is None:
                break
            self.tts.say(message)
            self.tts.runAndWait()
            self.speech_queue.task_done()

    def speak(self, message, urgency="normal"):
        current_time = datetime.now()
        threshold = timedelta(seconds=10 if urgency == "high" else 30)
        xml_message = f'<prosody rate="+15"><emphasis level="strong">{message}</emphasis></prosody>' if urgency == "high" else f'<prosody pitch="-15" rate="-10">{message}</prosody>'
        if message not in self.last_spoken or (current_time - self.last_spoken[message]) > threshold:
            self.speech_queue.put(xml_message)
            self.last_spoken[message] = current_time

    def get_location(self, box):
        x_center = (box[0] + box[2]) / 2
        if x_center < self.frame_width / 3:
            return "left"
        elif x_center < 2 * self.frame_width / 3:
            return "center"
        return "right"

    def compute_iou(self, box1, box2):
        x1_min, y1_min, x1_max, y1_max = box1
        x2_min, y2_min, x2_max, y2_max = box2
        inter_x_min = max(x1_min, x2_min)
        inter_y_min = max(y1_min, y2_min)
        inter_x_max = min(x1_max, x2_max)
        inter_y_max = min(y1_max, y2_max)
        inter_area = max(0, inter_x_max - inter_x_min) * max(0, inter_y_max - inter_y_min)
        box1_area = (x1_max - x1_min) * (y1_max - y1_min)
        box2_area = (x2_max - x2_min) * (y2_max - y2_min)
        return inter_area / (box1_area + box2_area - inter_area) if box1_area + box2_area > 0 else 0

    def classify_scene(self, frame):
        frame_tensor = torch.from_numpy(frame).permute(2, 0, 1).unsqueeze(0).float() / 255.0
        if torch.cuda.is_available():
            frame_tensor = frame_tensor.cuda()
        with torch.no_grad():
            output = self.scene_classifier(frame_tensor)
            scene_id = torch.argmax(output).item()
        return "indoor" if scene_id < 500 else "outdoor"

    def detect_tampering(self, track, previous_position):
        current_position = track.to_tlbr()
        return np.linalg.norm(np.array(current_position) - np.array(previous_position)) > 50 and track.det_class in self.stationary_objects

    def get_weather(self):
