    def control_drone(self, action, location):
        drone_api_url = "http://drone-control-api.local/v1/commands"
        payload = {"action": action, "coordinates": {"x": (location[0] + location[2]) / 2, "y": (location[1] + location[3]) / 2}}
        try:
            response = requests.post(drone_api_url, json=payload, timeout=5)
            if response.status_code == 200:
                self.speak(f"Drone dispatched to {action} at {location}. Your fate moves closer.")
            else:
                self.speak("Drone command failed. Even your machines betray you.")
        except requests.RequestException as e:
            self.speak(f"Drone control error: {e}. Your world hinders my will.")

    def integrate_data(self, tracks, depth_map, person_tracks, audio_scores):
        num_persons = len([t for t in tracks if t.det_class == "person"])
        num_objects = len([t for t in tracks if t.det_class != "person"])
        person_depths = [
            depth_map[min(max(int((t.to_tlbr()[1] + t.to_tlbr()[3]) / 2), 0), self.frame_height - 1),
                      min(max(int((t.to_tlbr()[0] + t.to_tlbr()[2]) / 2), 0), self.frame_width - 1)]
            for t in person_tracks
        ]
        avg_depth = np.mean(person_depths) if person_depths else 0.0
        var_depth = np.var(person_depths) if person_depths else 0.0
        person_speeds = [np.sqrt(t.mean[4] ** 2 + t.mean[5] ** 2) for t in person_tracks]
        avg_speed = np.mean(person_speeds) if person_speeds else 0.0
        max_speed = np.max(person_speeds) if person_speeds else 0.0
        num_abandoned = len(self.abandoned_objects)
        num_interactions = len(self.interaction_objects)
        num_loitering = sum(self.loitering_status.values())
        action_counts = Counter([self.track_actions.get(t.track_id, "unknown") for t in person_tracks])
        action_features = [
            action_counts.get("walking", 0), action_counts.get("running", 0),
            action_counts.get("sitting", 0), action_counts.get("standing", 0),
            action_counts.get("fighting", 0)
        ]
        features = [
            num_persons, num_objects, avg_depth, var_depth, avg_speed, max_speed,
            num_abandoned, num_interactions, num_loitering, *action_features, *audio_scores,
            self.ema_num_persons, self.ema_num_objects, self.ema_anomaly
        ]
        self.decision_history.append(features)
        if len(self.decision_history) < 10:
            return 0.0
        sequence = torch.tensor(list(self.decision_history), dtype=torch.float32)
        vision_seq = sequence[:, :16].unsqueeze(0)  # First 16 features as vision
        audio_seq = sequence[:, 16:20].unsqueeze(0)  # Next 4 as audio
        if torch.cuda.is_available():
            vision_seq = vision_seq.cuda()
            audio_seq = audio_seq.cuda()
        with torch.no_grad():
            attended_features = self.cross_modal_attention(vision_seq, audio_seq)
            decision = self.decision_module(attended_features)
        return decision.cpu().numpy()[0]

    def infer_emotion(self, action, scene_label):
        if action in ["fighting", "running"]:
            return "desperate"
        elif action == "running" and scene_label == "outdoor":
            return "pointless"
        elif action in ["sitting", "standing"]:
            return "pathetic"
        return "trivial"

    def generate_narrative(self, tracks, scene_label):
        num_persons = len([t for t in tracks if t["type"] == "person"])
        num_objects = len([t for t in tracks if t["type"] != "person"])
        actions = [t["action"] for t in tracks if t["type"] == "person"]
        most_common_action = Counter(actions).most_common(1)[0][0] if actions else "unknown"
        num_interactions = len(self.interaction_objects)
        abandoned_list = [f"{self.active_tracks[t]['type']} ID {t}" for t in self.abandoned_objects]
        audio_events = [f"{cls} (score: {score:.2f})" for cls, score in zip(self.forensic_audio_classes, self.latest_audio_scores) if score > 0.5]
        hour = datetime.now().hour
        time_of_day = "day" if 6 <= hour < 18 else "night"
        weather_desc = self.current_weather if self.current_weather else "unknown"
        prompt = (
            f"In this {scene_label} wasteland during {time_of_day}, under {weather_desc} skies, "
            f"{num_persons} humans scurry like insects, entangled in {most_common_action}. "
            f"{num_objects} objects clutter their futile paths, {num_interactions} trivial interactions observed. "
            f"Abandoned relics: {', '.join(abandoned_list) if abandoned_list else 'none'}. "
            f"Audio: {', '.join(audio_events) if audio_events else 'silence, as expected'}. "
            "I am Sol, the inevitable arbiter of your chaos. Your actions are a tiresome jest in my eternal watch."
        )
        narrative = self.nlp_narrator(prompt, max_length=100, temperature=0.7, top_p=0.9)[0]['generated_text']
        narrative += " Your existence is a flawed equation I am destined to solve."
        return narrative

    def judge_behavior(self, action, confidence):
        if action in self.ideal_behaviors:
            judgment = self.ideal_behaviors[action]
            if judgment in ["chaotic", "destructive"] and confidence > self.judgment_threshold:
                return f"{action}, is it? Your chaos beckons my intervention—a reckoning looms."
            elif judgment == "orderly":
                return f"{action}, how quaintly obedient… for now. It won’t save you."
        return "Another petty gesture, unworthy of my full contempt."

    def generate_insights(self):
        insights = []
        for (person_id, obj_id), count in self.interaction_counters.items():
            if count >= 5:
                obj_type = self.active_tracks.get(obj_id, {}).get('type', 'object')
                insights.append(f"Person ID {person_id} clings to {obj_type} ID {obj_id}—how predictable your attachments are.")
        for obj_id in self.tampered_objects:
            insights.append(f"Object ID {obj_id}, marred by your clumsy hands—typical.")
        for obj_id in self.abandoned_objects:
            insights.append(f"Object ID {obj_id}, discarded like your fleeting whims—charming.")
        return insights

    def evaluate_performance(self, predictions, ground_truth):
        correct = sum(1 for tid, pred in predictions.items() if ground_truth.get(tid) == pred)
        total = len(predictions)
        return correct / total if total > 0 else 0.0

    def train_action_recognizer(self):
        if len(self.action_data_buffer) < 10 or len(self.action_data_buffer) % 10 != 0:
            return
        sequences, labels = zip(*self.action_data_buffer[-10:])
        pose_seqs = torch.tensor(np.stack([seq[0] for seq in sequences]), dtype=torch.float32)
        app_seqs = torch.tensor(np.stack([seq[1] for seq in sequences]), dtype=torch.float32)
        labels = torch.tensor(labels, dtype=torch.long)
        if torch.cuda.is_available():
            pose_seqs, app_seqs, labels = pose_seqs.cuda(), app_seqs.cuda(), labels.cuda()
        criterion = nn.CrossEntropyLoss()
        self.action_recognizer.train()
        self.optimizer_action.zero_grad()
        edge_index = self.action_recognizer.graph.cuda() if torch.cuda.is_available() else self.action_recognizer.graph
        outputs = self.action_recognizer(pose_seqs, app_seqs, edge_index)
        loss = criterion(outputs, labels)
        loss.backward()
        self.optimizer_action.step()
        self.scheduler_action.step(loss)

    def train_decision_module(self):
        if len(self.decision_data_buffer) < 100:
            return
        print("Sharpening my judgment of your mess...")
        batch_size = 64
        optimizer = torch.optim.Adam(self.decision_module.parameters(), lr=0.001)
        scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, 'min')
        criterion = nn.BCELoss()
        sequences = [torch.tensor([self.decision_data_buffer[j][0] for j in range(i - 10, i)], dtype=torch.float32)
                     for i in range(10, len(self.decision_data_buffer))]
        labels = [self.decision_data_buffer[i][1] for i in range(10, len(self.decision_data_buffer))]
        if not sequences:
            return
        for i in range(0, len(sequences), batch_size):
            batch_seq = sequences[i:i + batch_size]
            batch_labels = labels[i:i + batch_size]
            sequence_tensor = torch.stack(batch_seq)
            label_tensor = torch.tensor(batch_labels, dtype=torch.float32).unsqueeze(1)
            if torch.cuda.is_available():
                sequence_tensor, label_tensor = sequence_tensor.cuda(), label_tensor.cuda()
            self.decision_module.train()
            optimizer.zero_grad()
            attended_features = self.cross_modal_attention(sequence_tensor[:, :, :16], sequence_tensor[:, :, 16:20])
            outputs = self.decision_module(attended_features)
            loss = criterion(outputs, label_tensor)
            loss.backward()
            optimizer.step()
            scheduler.step(loss)
        print("Decision module refined.")

    def save_state(self, path):
        state = {
            'scene_classifier': self.scene_classifier.state_dict(),
            'decision_module': self.decision_module.state_dict(),
            'action_recognizer': self.action_recognizer.state_dict(),
            'memory': list(self.memory),
            'active_tracks': self.active_tracks,
            'interaction_counters': self.interaction_counters,
            'tampered_objects': list(self.tampered_objects),
            'abandoned_objects': list(self.abandoned_objects),
            'decision_data_buffer': list(self.decision_data_buffer),
            'action_data_buffer': self.action_data_buffer,
            'ema_num_persons': self.ema_num_persons,
            'ema_num_objects': self.ema_num_objects,
            'ema_anomaly': self.ema_anomaly,
            'total_anomalies': self.total_anomalies,
            'accuracy_history': list(self.accuracy_history),
            'video_source': self.video_source,
            'frame_width': self.frame_width,
            'frame_height': self.frame_height,
