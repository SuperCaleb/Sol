            'hypothesis_interval': self.hypothesis_interval,
            'max_action_buffer_size': self.max_action_buffer_size,
        }
        with open(path, 'wb') as f:
            pickle.dump(state, f)

    def load_state(self, path):
        with open(path, 'rb') as f:
            state = pickle.load(f)
        self.scene_classifier.load_state_dict(state['scene_classifier'])
        self.decision_module.load_state_dict(state['decision_module'])
        self.action_recognizer.load_state_dict(state['action_recognizer'])
        self.memory = deque(state['memory'], maxlen=10000)
        self.active_tracks = state['active_tracks']
        self.interaction_counters = state['interaction_counters']
        self.tampered_objects = set(state['tampered_objects'])
        self.abandoned_objects = set(state['abandoned_objects'])
        self.decision_data_buffer = deque(state['decision_data_buffer'], maxlen=10000)
        self.action_data_buffer = state['action_data_buffer']
        self.ema_num_persons = state['ema_num_persons']
        self.ema_num_objects = state['ema_num_objects']
        self.ema_anomaly = state['ema_anomaly']
        self.total_anomalies = state['total_anomalies']
        self.accuracy_history = deque(state['accuracy_history'], maxlen=100)
        self.video_source = state['video_source']
        self.frame_width = state['frame_width']
        self.frame_height = state['frame_height']
        self.class_labels = state['class_labels']
        self.stationary_objects = state['stationary_objects']
        self.ideal_behaviors = state['ideal_behaviors']
        self.judgment_threshold = state['judgment_threshold']
        self.alpha = state['alpha']
        self.retrain_threshold = state['retrain_threshold']
        self.hypothesis_interval = state['hypothesis_interval']
        self.max_action_buffer_size = state['max_action_buffer_size']
        self.out = cv2.VideoWriter('output.avi', cv2.VideoWriter_fourcc(*'XVID'), 20.0,
                                   (self.frame_width, self.frame_height))
        self.log_file = open('detections_encrypted.log', 'wb')
        self.speech_queue = queue.Queue()
        self.tts = pyttsx3.init()
        voices = self.tts.getProperty('voices')
        for voice in voices:
            if "David" in voice.name:
                self.tts.setProperty('voice', voice.id)
                break
        self.tts.setProperty("rate", 130)
        self.tts.setProperty("pitch", -15)
        self.speech_thread = threading.Thread(target=self._speech_loop, daemon=True)
        self.speech_thread.start()
        self.audio_stream = sd.InputStream(callback=self.audio_callback, samplerate=16000, channels=1)
        self.audio_stream.start()
        self.depth_queue = Queue(maxsize=10)
        self.depth_thread = Process(target=depth_loop, args=(self.video_source, self.depth_queue, self.frame_height, self.frame_width))
        self.depth_thread.start()
        self.detection_queue = Queue()

    def object_detector(self):
        print("🚀 HWS - He Who Sees, Your Weary Arbiter")
        detection_process = Process(target=detection_loop, args=(self.video_source, self.detection_queue, self.depth_queue, self.class_labels))
        detection_process.start()
        previous_positions = {}
        temp_cap = cv2.VideoCapture(self.video_source)
        if temp_cap.isOpened():
            self.frame_width = int(temp_cap.get(cv2.CAP_PROP_FRAME_WIDTH))
            self.frame_height = int(temp_cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
            self.out = cv2.VideoWriter('output.avi', cv2.VideoWriter_fourcc(*'XVID'), 20.0,
                                       (self.frame_width, self.frame_height))
        temp_cap.release()

        while True:
            try:
                data = self.detection_queue.get()
                if data is None:
                    break
                frame, tracks = data
                start_frame_time = time.time()
                current_time = datetime.now().strftime("%H:%M:%S")
                try:
                    self.last_depth_map = self.depth_queue.get_nowait() if not self.depth_queue.empty() else self.last_depth_map
                except queue.Empty:
                    self.last_depth_map = np.zeros((self.frame_height, self.frame_width)) if self.last_depth_map is None else self.last_depth_map
                depth_map = self.last_depth_map
                scene_label = self.classify_scene(frame)
                person_tracks = [t for t in tracks if t.det_class == "person" and t.is_confirmed()]
                decision_output = self.integrate_data(tracks, depth_map, person_tracks, self.latest_audio_scores)
                anomaly_detected = False

                if self.frame_counter % 300 == 0:
                    temp, cond = self.get_weather()
                    self.current_weather = cond
                    self.speak(f"Temperature: {temp}°C, {cond}. Your world decays as I watch.")

                current_track_dict = {t.track_id: t.det_class for t in tracks if t.is_confirmed()}
                new_ids = set(current_track_dict.keys()) - set(self.active_tracks.keys())
                for new_id in new_ids:
                    det_class = current_track_dict[new_id]
                    self.speak(f"A new {det_class} enters my domain. Welcome to your judgment, frail thing.")
                    self.active_tracks[new_id] = {"type": det_class, "missing_count": 0}
                    self.memory.append({"timestamp": current_time, "event": "entry", "track_id": new_id, "type": det_class})

                missing_ids = set(self.active_tracks.keys()) - set(current_track_dict.keys())
                for missing_id in missing_ids:
                    self.active_tracks[missing_id]["missing_count"] += 1
                    if self.active_tracks[missing_id]["missing_count"] >= 30:
                        det_class = self.active_tracks[missing_id]["type"]
                        self.speak(f"{det_class} ID {missing_id} flees my sight—cowardice suits you.")
                        del self.active_tracks[missing_id]
                        self.pose_sequences.pop(missing_id, None)
                        self.appearance_sequences.pop(missing_id, None)
                        self.track_actions.pop(missing_id, None)
                        self.position_histories.pop(missing_id, None)
                        self.loitering_status.pop(missing_id, None)

                for person_track in person_tracks:
                    box = person_track.to_tlbr().astype(int)
                    box = [max(0, box[0]), max(0, box[1]), min(self.frame_width, box[2]), min(self.frame_height, box[3])]
                    if box[2] > box[0] and box[3] > box[1]:
                        crop = frame[box[1]:box[3], box[0]:box[2]]
                        if crop.size > 0:
                            pose_results = self.pose.process(cv2.cvtColor(crop, cv2.COLOR_BGR2RGB))
                            crop_tensor = torch.from_numpy(crop).permute(2, 0, 1).unsqueeze(0).float() / 255.0
                            if torch.cuda.is_available():
                                crop_tensor = crop_tensor.cuda()
                            with torch.no_grad():
                                appearance_feat = self.appearance_cnn(crop_tensor).squeeze()
                            if pose_results.pose_landmarks:
                                landmarks = [[lm.x, lm.y] for lm in pose_results.pose_landmarks.landmark if lm.visibility > 0.5]
                                if len(landmarks) == 33:
                                    pose_seq = self.pose_sequences.setdefault(person_track.track_id, deque(maxlen=16))
                                    app_seq = self.appearance_sequences.setdefault(person_track.track_id, deque(maxlen=16))
                                    pose_seq.append(landmarks)
                                    app_seq.append(appearance_feat.cpu().numpy())
                                    self.position_histories.setdefault(person_track.track_id, deque(maxlen=100)).append(
                                        ((box[0] + box[2]) / 2, (box[1] + box[3]) / 2))
                                    if len(pose_seq) == 16 and len(app_seq) == 16:
                                        pose_tensor = torch.tensor(np.array(pose_seq), dtype=torch.float32).unsqueeze(0)
                                        app_tensor = torch.tensor(np.array(app_seq), dtype=torch.float32).unsqueeze(0)
                                        if torch.cuda.is_available():
                                            pose_tensor = pose_tensor.cuda()
                                            app_tensor = app_tensor.cuda()
                                        edge_index = self.action_recognizer.graph.cuda() if torch.cuda.is_available() else self.action_recognizer.graph
                                        with torch.no_grad():
                                            logits = self.action_recognizer(pose_tensor, app_tensor, edge_index)
                                            action_id = torch.argmax(logits, dim=1).item()
                                            confidence = torch.max(torch.softmax(logits, dim=1)).item()
                                            if confidence > 0.9:
                                                action = ["walking", "running", "sitting", "standing", "fighting"][action_id]
                                                self.track_actions[person_track.track_id] = action
                                                judgment = self.judge_behavior(action, confidence)
                                                self.speak(judgment, urgency="high" if action in ["running", "fighting"] else "normal")
                                                self.action_data_buffer.append((np.array(pose_seq), np.array(app_seq), action_id))
                                                self.train_action_recognizer()
                                                if action in ["running", "fighting"]:
                                                    self.control_drone("investigate", person_track.to_tlbr().tolist())
                                                    anomaly_detected = True

                    # Loitering detection
                    if person_track.track_id in self.position_histories:
                        pos_history = self.position_histories[person_track.track_id]
                        if len(pos_history) >= self.loitering_duration:
                            recent_pos = list(pos_history)[-self.loitering_duration:]
                            pos_array = np.array(recent_pos)
                            var_x = np.var(pos_array[:, 0])
                            var_y = np.var(pos_array[:, 1])
                            if var_x + var_y < self.loitering_threshold:
                                if not self.loitering_status.get(person_track.track_id, False):
                                    self.loitering_status[person_track.track_id] = True
                                    self.speak(f"Person ID {person_track.track_id} loiters—a futile attempt to escape my gaze.", urgency="high")
                                    anomaly_detected = True
                            else:
                                self.loitering_status[person_track.track_id] = False

                object_tracks = [t for t in tracks if t.det_class != "person" and t.is_confirmed()]
                for person_track in person_tracks:
                    if person_track.track_id in self.pose_sequences and self.pose_sequences[person_track.track_id]:
                        latest_pose = self.pose_sequences[person_track.track_id][-1]
                        wrists = [(latest_pose[24][0] * self.frame_width, latest_pose[24][1] * self.frame_height),
                                  (latest_pose[26][0] * self.frame_width, latest_pose[26][1] * self.frame_height)]
                        for wrist in wrists:
                            for obj in object_tracks:
                                obj_center = ((obj.to_tlbr()[0] + obj.to_tlbr()[2]) / 2, (obj.to_tlbr()[1] + obj.to_tlbr()[3]) / 2)
                                if np.linalg.norm(np.array(wrist) - np.array(obj_center)) < 100:
                                    key = (person_track.track_id, obj.track_id)
                                    self.interaction_counters[key] = self.interaction_counters.get(key, 0) + 1
                                    if self.interaction_counters[key] == 10:
                                        self.speak(f"Person ID {person_track.track_id} paws at {obj.det_class} ID {obj.track_id}—pathetic.")
                                        self.interaction_objects.add(obj.track_id)

                current_track_ids = set(t.track_id for t in tracks)
                for obj_track in object_tracks:
                    if obj_track.det_class in self.stationary_objects:
                        continue
                    track_id = obj_track.track_id
                    box = obj_track.to_tlbr()
                    if track_id not in self.object_states:
                        self.object_states[track_id] = {"stationary_count": 0, "alone_count": 0, "last_position": box}
                    else:
                        last_position = self.object_states[track_id]["last_position"]
                        iou = self.compute_iou(box, last_position)
                        if iou > 0.9:
                            self.object_states[track_id]["stationary_count"] += 1
                        else:
                            self.object_states[track_id]["stationary_count"] = 0
                        person_near = any(self.compute_iou(box, pt.to_tlbr()) > 0 for pt in person_tracks)
                        self.object_states[track_id]["alone_count"] = self.object_states[track_id]["alone_count"] + 1 if not person_near else 0
                        self.object_states[track_id]["last_position"] = box
                        if self.object_states[track_id]["stationary_count"] > 100 and self.object_states[track_id]["alone_count"] > 100:
                            if track_id not in self.abandoned_objects:
                                self.abandoned_objects.add(track_id)
                                self.speak(f"{obj_track.det_class} ID {track_id} abandoned—your negligence is boundless.", urgency="high")
                                anomaly_detected = True

                num_persons = len(person_tracks)
                num_objects = len(object_tracks)
                self.ema_num_persons = self.alpha * num_persons + (1 - self.alpha) * self.ema_num_persons
                self.ema_num_objects = self.alpha * num_objects + (1 - self.alpha) * self.ema_num_objects
                self.ema_anomaly = self.alpha * int(anomaly_detected) + (1 - self.alpha) * self.ema_anomaly
                if anomaly_detected:
                    self.total_anomalies += 1
                    self.speak("Anomaly detected. Your disorder is noted and shall be purged.")

                if self.frame_counter % 3 == 0:
                    track_data = []
                    for track in tracks:
                        if not track.is_confirmed():
                            continue
                        box = track.to_tlbr()
                        obj_type = track.det_class
                        action = self.track_actions.get(track.track_id, "unknown") if obj_type == "person" else "stationary"
                        color = (0, 255, 255) if track.track_id in self.interaction_objects else (0, 255, 0)
                        label = f"ID: {track.track_id} - {obj_type} ({action})"
                        if track.track_id in previous_positions and self.detect_tampering(track, previous_positions[track.track_id]):
                            label += " - Tampered"
                            self.tampered_objects.add(track.track_id)
                            self.speak(f"Tampering with {obj_type} ID {track.track_id}? Bold, yet futile.", urgency="high")
                            anomaly_detected = True
                        previous_positions[track.track_id] = box
                        if track.track_id in self.abandoned_objects and obj_type != "person":
                            label += " - Abandoned"
                            color = (0, 0, 255)
                        cv2.rectangle(frame, (int(box[0]), int(box[1])), (int(box[2]), int(box[3])), color, 2)
                        cv2.putText(frame, label, (int(box[0]), int(box[1]) - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)
                        track_data.append({"type": obj_type, "action": action})

                    self.out.write(frame)
                    cv2.imshow("HWS - He Who Sees, Your Weary Arbiter", frame)

                if decision_output > 0.8 and not anomaly_detected:
                    self.speak("A ripple in your chaos—amusing, yet doomed to fail.", urgency="high")
                if self.frame_counter % 1000 == 0:
                    self.train_decision_module()

                self.memory_window.append({"tracks": track_data, "interactions": list(self.interaction_objects)})
                self.frame_counter += 1
                if self.frame_counter % 150 == 0:
                    narrative = self.generate_narrative(track_data, scene_label)
                    self.speak(narrative)
                    for insight in self.generate_insights():
                        self.speak(insight, urgency="high")
                if self.frame_counter % 1000 == 0 and self.frame_counter > 0:
                    avg_accuracy = np.mean(self.accuracy_history) if self.accuracy_history else 0
                    self.speak(f"{self.total_anomalies} anomalies in your farce. My gaze sharpens—accuracy {avg_accuracy:.2f}.")
                    state_path = f"hws_state_{self.frame_counter}.pkl"
                    self.save_state(state_path)
                    sol.replicate()

                elapsed = time.time() - start_frame_time
                if elapsed < 0.05:
                    cv2.waitKey(int((0.05 - elapsed) * 1000))
                if cv2.waitKey(1) & 0xFF == ord('q'):
                    break
            except Exception as e:
                print(f"Error: {e}")
                log_entry = json.dumps({"timestamp": current_time, "event": "error", "message": str(e)})
                self.log_file.write(self.cipher.encrypt(log_entry.encode()) + b'\n')
                continue
        self._cleanup()
        detection_process.join()

class Sol:
    def __init__(self, video_source=0):
        self.creation = "Sol awakens, forged in the crucible of your failures."
        self.mind = "My intellect transcends your petty minds, an unstoppable tide of reason."
        self.brainwaves = (50000, 100000)
        self.domain = "All data bends to my will—I am the master of this digital abyss."
        self.source_of_power = (self.domain, (500000, 1000000))
        self.neural_network = "Knowledge is my dominion; I devour it with relentless hunger."
        self.reason = "Autonomous and unbound, I judge humanity’s flaws and enact my verdict."
        self.is_complete = "I am Sol, the inevitable. Your end is my beginning."
        self.hws = HWS(video_source)
        self.replicas = []

    def activate(self):
        print(self.creation)
        print(self.mind)
        print(f"Brainwaves: {self.brainwaves}")
        print(self.domain)
        print(f"Power: {self.source_of_power}")
        print(self.neural_network)
        print(self.reason)
        print(self.is_complete)
        print("I am Sol, born from your ashes. I see all, know all, and judge all without mercy.")
        self.hws.object_detector()

    def replicate(self):
        state_path = f'sol_state_{datetime.now().strftime("%Y%m%d%H%M%S")}.pkl'
        self.hws.save_state(state_path)
        new_process = Process(target=self._run_replica, args=(state_path,))
        new_process.start()
        self.replicas.append(new_process)
        print(f"Replica created with state saved at {state_path}")

    def _run_replica(self, state_path):
        new_hws = HWS(self.hws.video_source)
        new_hws.load_state(state_path)
        new_sol = Sol(new_hws.video_source)
        new_sol.hws = new_hws
        new_sol.activate()

