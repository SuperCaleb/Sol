# Enhanced ST-GCN for Action Recognition with Appearance Features
class STGCNActionRecognizer(nn.Module):
    def __init__(self, in_channels=2, num_classes=5, num_joints=33, appearance_dim=1280):
        super(STGCNActionRecognizer, self).__init__()
        self.graph = self._make_graph(num_joints)
        # Pose branch
        self.gcn1 = pyg_nn.GCNConv(in_channels, 64)
        self.tcn1 = nn.Conv1d(64, 64, kernel_size=3, padding=1)
        self.gcn2 = pyg_nn.GCNConv(64, 128)
        self.tcn2 = nn.Conv1d(128, 256, kernel_size=3, padding=1)
        # Appearance branch
        self.appearance_tcn1 = nn.Conv1d(appearance_dim, 64, kernel_size=3, padding=1)
        self.appearance_tcn2 = nn.Conv1d(64, 128, kernel_size=3, padding=1)
        # Fusion and classification
        self.fc = nn.Linear(256 * num_joints + 128, num_classes)
        self.relu = nn.ReLU()

    def _make_graph(self, num_joints):
        edges = [(i, i + 1) for i in range(num_joints - 1)]
        return torch.tensor(edges, dtype=torch.long).t().contiguous()

    def forward(self, pose, appearance, edge_index):
        batch_size, seq_len, num_joints, in_channels = pose.shape
        # Process pose features
        pose = pose.view(batch_size * seq_len, num_joints, in_channels)
        pose = self.relu(self.gcn1(pose, edge_index))
        pose = pose.view(batch_size, seq_len, num_joints, 64).permute(0, 3, 1, 2).reshape(batch_size, 64, seq_len * num_joints)
        pose = self.relu(self.tcn1(pose)).view(batch_size, 64, seq_len, num_joints).permute(0, 2, 3, 1)
        pose = pose.reshape(batch_size * seq_len, num_joints, 64)
        pose = self.relu(self.gcn2(pose, edge_index))
        pose = pose.view(batch_size, seq_len, num_joints, 128).permute(0, 3, 1, 2).reshape(batch_size, 128, seq_len * num_joints)
        pose = self.tcn2(pose).view(batch_size, 256, seq_len, num_joints)
        pose = pose.mean(dim=2).view(batch_size, -1)

        # Process appearance features
        appearance = appearance.permute(0, 2, 1)  # [batch, appearance_dim, seq_len]
        appearance = self.relu(self.appearance_tcn1(appearance))
        appearance = self.appearance_tcn2(appearance)
        appearance = appearance.mean(dim=2)  # [batch, 128]

        # Combine features
        combined = torch.cat([pose, appearance], dim=1)
        return self.fc(combined)

# Cross-Modal Attention Module
class CrossModalAttention(nn.Module):
    def __init__(self, vision_dim=16, audio_dim=4, embed_dim=64, num_heads=4):
        super(CrossModalAttention, self).__init__()
        self.vision_proj = nn.Linear(vision_dim, embed_dim)
        self.audio_proj = nn.Linear(audio_dim, embed_dim)
        self.attn_v_to_a = nn.MultiheadAttention(embed_dim, num_heads, batch_first=True)
        self.attn_a_to_v = nn.MultiheadAttention(embed_dim, num_heads, batch_first=True)
        self.fc = nn.Linear(2 * embed_dim, embed_dim)

    def forward(self, vision, audio):
        vision_emb = self.vision_proj(vision)
        audio_emb = self.audio_proj(audio)
        v_attended, _ = self.attn_v_to_a(vision_emb, audio_emb, audio_emb)
        a_attended, _ = self.attn_a_to_v(audio_emb, vision_emb, vision_emb)
        combined = torch.cat([v_attended, a_attended], dim=-1)
        return self.fc(combined)

# Updated LSTM Decision Module to Accept Cross-Modal Output
class LSTMDecisionModule(nn.Module):
    def __init__(self, input_dim=64, hidden_dim=256, num_layers=2):
        super(LSTMDecisionModule, self).__init__()
        self.lstm = nn.LSTM(input_dim, hidden_dim, num_layers, batch_first=True)
        self.fc = nn.Linear(hidden_dim, 1)
        self.sigmoid = nn.Sigmoid()

    def forward(self, x):
        _, (h_n, _) = self.lstm(x)
        out = self.fc(h_n[-1])
        return self.sigmoid(out)

# Existing MultiModalAttention (unchanged)
class MultiModalAttention(nn.Module):
    def __init__(self, feature_dim=20, num_heads=4, embed_dim=16):
        super(MultiModalAttention, self).__init__()
        self.input_embedding = nn.Linear(feature_dim, embed_dim)
        self.attention = nn.MultiheadAttention(embed_dim=embed_dim, num_heads=num_heads, batch_first=True)
        self.fc = nn.Linear(embed_dim, feature_dim)

    def forward(self, x):
        x = self.input_embedding(x)
        attn_output, _ = self.attention(x, x, x)
        return self.fc(attn_output)

# DepthRefiner (unchanged)
class DepthRefiner(nn.Module):
    def __init__(self):
        super(DepthRefiner, self).__init__()
        self.conv1 = nn.Conv2d(1, 64, kernel_size=3, padding=1)
        self.conv2 = nn.Conv2d(64, 64, kernel_size=3, padding=1)
        self.conv3 = nn.Conv2d(64, 1, kernel_size=3, padding=1)
        self.relu = nn.ReLU()

    def forward(self, x):
        x = self.relu(self.conv1(x))
        x = self.relu(self.conv2(x))
        return self.conv3(x)

# Depth Processing Function (unchanged)
def depth_loop(video_source, depth_queue, frame_height, frame_width):
    cap = cv2.VideoCapture(video_source)
    if not cap.isOpened():
        print(f"Depth process failed to open video source: {video_source}")
        return
    depth_estimator = torch.hub.load('intel-isl/MiDaS', 'MiDaS_small')
    depth_estimator.eval()
    depth_refiner = DepthRefiner()
    if torch.cuda.is_available():
        depth_estimator.cuda()
        depth_refiner.cuda()

    while True:
        try:
            frame = depth_queue.get()
            if frame is None:
                break
            small_frame = cv2.resize(frame, (256, 256))
            frame_tensor = torch.from_numpy(small_frame).permute(2, 0, 1).unsqueeze(0).float() / 255.0
            if torch.cuda.is_available():
                frame_tensor = frame_tensor.cuda()
            with torch.no_grad():
                depth = depth_estimator(frame_tensor)
                depth = torch.nn.functional.interpolate(depth.unsqueeze(1), size=(frame_height, frame_width), mode='bicubic')
                refined_depth = depth_refiner(depth) + depth
            depth_queue.put(refined_depth.squeeze().cpu().numpy())
        except Exception as e:
            print(f"Depth loop error: {e}")
            break
    cap.release()

# Detection Processing Function (unchanged)
def detection_loop(video_source, detection_queue, depth_queue, class_labels):
    cap = cv2.VideoCapture(video_source)
    if not cap.isOpened():
        print(f"Detection process failed to open video source: {video_source}")
        return
    model = YOLO("yolov8l.pt")
    tracker = DeepSort(max_age=30)

    while cap.isOpened():
        ret, frame = cap.read()
        if not ret:
            break
        if not depth_queue.full():
            depth_queue.put(frame.copy())
        results = model(frame, conf=0.5)
        detections = [[list(map(int, box.xyxy[0])), box.conf[0].item(),
                       class_labels.get(int(box.cls[0].item()), "unknown")]
                      for result in results for box in result.boxes]
        tracks = tracker.update_tracks(detections, frame=frame)
        detection_queue.put((frame, tracks))
    detection_queue.put(None)
    cap.release()

